{
    "version": 1,
    "engine": "IAST",
    "hooks": {
        "hook.dom.htmlAssignments": {
            "id": "hook.dom.htmlAssignments",
            "title": "DOM HTML assignments",
            "description": "HTML assignment sinks on existing nodes and iframe srcdoc content.",
            "coversSinks": [
                "dom.innerHTML",
                "dom.outerHTML",
                "dom.insertAdjacentHTML",
                "nav.iframe.srcdoc"
            ],
            "cost": "medium",
            "defaultEnabled": true
        },
        "hook.dom.documentWrite": {
            "id": "hook.dom.documentWrite",
            "title": "document.write sinks",
            "description": "document.write with bounded inline event scanning.",
            "coversSinks": [
                "document.write",
                "dom.inline_event"
            ],
            "cost": "medium",
            "defaultEnabled": true
        },
        "hook.dom.htmlParsers": {
            "id": "hook.dom.htmlParsers",
            "title": "HTML parser and unsafe DOM sinks",
            "description": "DOMParser, contextual fragment, and unsafe HTML parser surfaces.",
            "coversSinks": [
                "dom.domParser.parseFromString",
                "dom.range.createContextualFragment",
                "dom.element.setHTMLUnsafe",
                "dom.shadowRoot.setHTMLUnsafe",
                "dom.inline_event"
            ],
            "cost": "medium",
            "defaultEnabled": true
        },
        "hook.dom.mutations": {
            "id": "hook.dom.mutations",
            "title": "DOM mutations and inserted nodes",
            "description": "Node insertion sinks (appendChild/insertBefore/etc) with attribute traversal.",
            "coversSinks": [
                "dom.mutation",
                "dom.inline_event",
                "script.element.src",
                "script.element.src.dataUrl",
                "dom.clobbering.named_property"
            ],
            "cost": "high",
            "defaultEnabled": true
        },
        "hook.dom.urlAttributes": {
            "id": "hook.dom.urlAttributes",
            "title": "URL-bearing DOM attributes",
            "description": "href/src/document.domain style assignments on existing nodes.",
            "coversSinks": [
                "dom.attr.href",
                "dom.attr.href.javascriptUrl",
                "dom.attr.href.dataUrl",
                "dom.attr.src",
                "dom.attr.src.javascriptUrl",
                "dom.attr.src.dataUrl",
                "http.image.src",
                "nav.iframe.src",
                "nav.iframe.src.javascriptUrl",
                "nav.iframe.src.dataUrl",
                "script.element.src",
                "script.element.src.dataUrl",
                "document.domain"
            ],
            "cost": "medium",
            "defaultEnabled": true
        },
        "hook.dom.formAttributes": {
            "id": "hook.dom.formAttributes",
            "title": "Form target attributes",
            "description": "Form action and formaction assignments on existing nodes.",
            "coversSinks": [
                "dom.attr.action",
                "dom.attr.action.javascriptUrl",
                "dom.attr.action.dataUrl",
                "dom.attr.formaction",
                "dom.attr.formaction.javascriptUrl",
                "dom.attr.formaction.dataUrl",
                "form.submit.call",
                "form.requestSubmit.call"
            ],
            "cost": "low",
            "defaultEnabled": true
        },
        "hook.dom.inlineEvents": {
            "id": "hook.dom.inlineEvents",
            "title": "Inline event attributes",
            "description": "Inline event handler attributes and setters on existing nodes.",
            "coversSinks": [
                "dom.inline_event"
            ],
            "cost": "low",
            "defaultEnabled": true
        },
        "hook.code.exec": {
            "id": "hook.code.exec",
            "title": "Dynamic code execution",
            "description": "eval, Function constructor, and string-based timers.",
            "coversSinks": [
                "code.eval",
                "code.function.constructor",
                "code.function.apply",
                "code.setTimeout",
                "code.setInterval"
            ],
            "cost": "low",
            "defaultEnabled": true
        },
        "hook.nav.redirects": {
            "id": "hook.nav.redirects",
            "title": "Navigation and redirects",
            "description": "location.href/assign/replace and window.open redirects.",
            "coversSinks": [
                "nav.location.href",
                "nav.location.href.javascriptUrl",
                "nav.location.href.dataUrl",
                "nav.location.assign",
                "nav.location.assign.javascriptUrl",
                "nav.location.assign.dataUrl",
                "nav.location.replace",
                "nav.location.replace.javascriptUrl",
                "nav.location.replace.dataUrl",
                "nav.history.pushState",
                "nav.history.replaceState",
                "nav.navigation.navigate",
                "nav.window.open",
                "nav.window.open.javascriptUrl",
                "nav.window.open.dataUrl"
            ],
            "cost": "low",
            "defaultEnabled": true
        },
        "hook.net.exfil": {
            "id": "hook.net.exfil",
            "title": "Network exfiltration",
            "description": "Fetch/XHR/sendBeacon/WebSocket/RTC data egress.",
            "coversSinks": [
                "csrf.fetch",
                "http.fetch.url",
                "http.fetch.headers",
                "http.xhr.open",
                "http.xhr.send",
                "http.xhr.setRequestHeader",
                "http.navigator.sendBeacon",
                "http.image.src",
                "clipboard.writeText",
                "realtime.websocket.send",
                "realtime.webrtc.send",
                "realtime.websocket.url"
            ],
            "cost": "medium",
            "defaultEnabled": true
        },
        "hook.net.responses": {
            "id": "hook.net.responses",
            "title": "Network response field sources",
            "description": "Fetch/XHR JSON response field extraction for response-derived taint sources.",
            "producesSources": [
                "apiResponseField",
                "graphqlResponseField"
            ],
            "cost": "medium",
            "defaultEnabled": true
        },
        "hook.client.json": {
            "id": "hook.client.json",
            "title": "Client-side parser/interpreter sinks",
            "description": "JSON parsing, FileReader, XPath evaluate, and client SQL sinks.",
            "coversSinks": [
                "client.json.parse",
                "client.filereader.readAsText",
                "client.filereader.readAsDataURL",
                "client.filereader.readAsArrayBuffer",
                "dom.xpath.evaluate",
                "client.sql.openDatabase",
                "client.sql.executeSql"
            ],
            "cost": "low",
            "defaultEnabled": true
        },
        "hook.storage": {
            "id": "hook.storage",
            "title": "Storage and cookies",
            "description": "Storage writes and cookie persistence; storage/cookie sources.",
            "coversSinks": [
                "storage.localStorage.setItem",
                "storage.sessionStorage.setItem",
                "storage.document.cookie",
                "storage.indexeddb.put",
                "storage.cache.put"
            ],
            "producesSources": [
                "localStorage",
                "sessionStorage",
                "cookie",
                "indexedDb",
                "cacheStorage"
            ],
            "cost": "low",
            "defaultEnabled": true
        },
        "hook.postMessage": {
            "id": "hook.postMessage",
            "title": "postMessage and channels",
            "description": "postMessage, BroadcastChannel, and MessagePort sinks; message data sources.",
            "coversSinks": [
                "postmessage.anyOrigin",
                "postmessage.crossOrigin",
                "channel.broadcast.postMessage",
                "channel.messageport.postMessage"
            ],
            "producesSources": [
                "postMessage",
                "broadcastMessage",
                "messagePort",
                "workerMessage"
            ],
            "cost": "low",
            "defaultEnabled": true
        },
        "hook.console.leaks": {
            "id": "hook.console.leaks",
            "title": "Console leakage",
            "description": "console.log/error sinks.",
            "coversSinks": [
                "log.console.log",
                "log.console.error"
            ],
            "cost": "low",
            "defaultEnabled": true
        },
        "hook.script.loading": {
            "id": "hook.script.loading",
            "title": "Script loading",
            "description": "ServiceWorker and Worker script loading sinks.",
            "coversSinks": [
                "worker.serviceWorker.register",
                "worker.webworker.constructor",
                "worker.importScripts",
                "script.element.src"
            ],
            "cost": "low",
            "defaultEnabled": true
        },
        "hook.runtime.integrity": {
            "id": "hook.runtime.integrity",
            "title": "Runtime integrity and prototype pollution",
            "description": "Prototype-pollution write tracking and bounded downstream impact confirmation.",
            "coversSinks": [
                "runtime.prototype.pollution.write",
                "runtime.prototype.pollution.fetchInit"
            ],
            "cost": "low",
            "defaultEnabled": true
        },
        "hook.sanitizers": {
            "id": "hook.sanitizers",
            "title": "Sanitizer and Trusted Types",
            "description": "Allow-listed sanitizers plus Trusted Types and DOMPurify policy/configuration sinks.",
            "coversSinks": [
                "trustedTypes.policy.createHTML",
                "trustedTypes.policy.createScript",
                "trustedTypes.policy.createScriptURL",
                "sanitizer.dompurify.config"
            ],
            "producesSanitizers": [
                "san.domPurify"
            ],
            "cost": "low",
            "defaultEnabled": false
        }
    },
