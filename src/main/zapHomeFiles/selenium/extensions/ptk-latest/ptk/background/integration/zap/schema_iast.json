{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ptk.local/schemas/ptk-zap-iast-finding-v1.json",
  "title": "PTK -> ZAP IAST Findings Batch (Minimum)",
  "type": "object",
  "additionalProperties": false,
  "required": ["source", "type", "schema", "ts", "batchId", "payload"],
  "properties": {
    "source": { "const": "ptk" },
    "type": { "const": "iast_findings_batch" },
    "schema": { "const": "ptk-zap-iast-finding-v1" },
    "ts": { "type": "integer", "minimum": 0 },
    "batchId": { "type": "string", "minLength": 1 },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engine", "scanId", "findings"],
      "properties": {
        "engine": { "const": "IAST" },
        "scanId": { "type": "string", "minLength": 1 },
        "truncated": { "type": "boolean" },
        "findings": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/finding" }
        }
      }
    }
  },
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "fingerprint",
        "moduleId",
        "ruleId",
        "severity",
        "confidence",
        "summary",
        "location",
        "context",
        "source",
        "sink",
        "proof"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "fingerprint": { "type": "string", "minLength": 1 },
        "moduleId": { "type": "string", "minLength": 1 },
        "ruleId": { "type": "string", "minLength": 1 },
        "severity": {
          "type": "string",
          "enum": ["high", "medium", "low"]
        },
        "confidence": { "type": "integer", "minimum": 0, "maximum": 100 },
        "summary": { "type": "string", "minLength": 1 },
        "location": { "$ref": "#/$defs/runtimeLocation" },
        "proof": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "payload", "proof", "summary"],
          "properties": {
            "mode": {
              "type": "string",
              "enum": ["taint", "signal"]
            },
            "payload": { "type": ["string", "null"] },
            "proof": { "type": ["string", "null"] },
            "summary": { "type": "string", "minLength": 1 }
          }
        },
        "source": { "$ref": "#/$defs/sourceRef" },
        "sink": { "$ref": "#/$defs/sinkRef" },
        "trace": { "type": ["string", "null"] },
        "context": { "$ref": "#/$defs/runtimeContext" }
      }
    },
    "runtimeLocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "route", "method", "param"],
      "properties": {
        "url": { "type": "string", "minLength": 1 },
        "route": { "type": ["string", "null"] },
        "method": { "type": ["string", "null"] },
        "param": { "type": ["string", "null"] }
      }
    },
    "runtimeContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domPath", "elementId", "tagName"],
      "properties": {
        "domPath": { "type": ["string", "null"] },
        "elementId": { "type": ["string", "null"] },
        "tagName": { "type": ["string", "null"] }
      }
    },
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "kind"],
      "properties": {
        "id": { "type": ["string", "null"] },
        "label": { "type": ["string", "null"] },
        "kind": { "type": ["string", "null"] }
      }
    },
    "sinkRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label"],
      "properties": {
        "id": { "type": ["string", "null"] },
        "label": { "type": ["string", "null"] }
      }
    }
  }
}
