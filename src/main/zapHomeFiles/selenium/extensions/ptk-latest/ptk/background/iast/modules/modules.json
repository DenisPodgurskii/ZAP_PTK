    {
      "id": "iast_response_field_dom_reachability",
      "type": "runtime",
      "async": true,
      "name": "Response-derived DOM execution reachability",
      "metadata": {
        "description": "Detect API and GraphQL response fields being fed into DOM HTML and parser sinks.",
        "recommendation": "<ul><li>Treat response fields as untrusted when rendering rich HTML or unsafe templates.</li><li>Prefer text rendering or strict allow-listing for any response-driven markup.</li></ul>",
        "category": "xss",
        "links": {
          "OWASP": "https://owasp.org/www-community/attacks/xss/",
          "CWE": "https://cwe.mitre.org/data/definitions/79.html"
        },
        "owasp": [
          "A05:2025 - Injection",
          "A03:2021 - Injection"
        ],
        "cwe": [
          "CWE-79"
        ],
        "tags": [
          "iast",
          "response",
          "dom",
          "xss"
        ],
        "severity": "high",
        "vulnId": "dom_xss"
      },
      "rules": [
        {
          "id": "response_dom_innerhtml_reachability",
          "name": "Response field rendered via innerHTML",
          "sinkId": "dom.innerHTML",
          "severity": "high",
          "sources": [
            "apiResponseField",
            "graphqlResponseField"
          ],
          "sanitizersAllowed": [
            "san.domPurify"
          ],
          "onSanitized": "lower_confidence",
          "metadata": {
            "description": "Response-derived data reached innerHTML."
          },
          "conditions": {
            "requiresTaint": true
          }
        },
        {
          "id": "response_dom_document_write_reachability",
          "name": "Response field rendered via document.write",
          "sinkId": "document.write",
          "severity": "high",
          "sources": [
            "apiResponseField",
            "graphqlResponseField"
          ],
          "sanitizersAllowed": [
            "san.domPurify"
          ],
          "onSanitized": "lower_confidence",
          "metadata": {
            "description": "Response-derived data reached document.write."
          },
          "conditions": {
            "requiresTaint": true
          }
        }
      ]
    },
    {
      "id": "iast_prototype_pollution_impact",
      "type": "runtime",
      "async": true,
      "name": "Prototype pollution impact confirmation",
      "metadata": {
        "description": "Detect dangerous prototype-key writes from tainted input and confirm downstream fetch() init impact.",
        "recommendation": "<ul><li>Reject __proto__, constructor, and prototype keys during object merge and parsing.</li><li>Use safe merge utilities and create null-prototype maps where appropriate.</li></ul>",
        "category": "client_side",
