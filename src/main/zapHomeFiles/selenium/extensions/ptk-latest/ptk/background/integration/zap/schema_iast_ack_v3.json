{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ptk.local/schemas/ptk-zap-iast-ack-v3.json",
  "title": "PTK ZAP IAST v3 ACK",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "result",
    "contractVersion",
    "schema",
    "structuredAck",
    "legacyAck",
    "received",
    "accepted",
    "alertsRaised",
    "findingResults",
    "reasonCounts",
    "permanentFailure",
    "scanCompletenessAccepted"
  ],
  "properties": {
    "result": {
      "enum": [
        "OK",
        "ERROR"
      ]
    },
    "contractVersion": {
      "const": 3
    },
    "schema": {
      "const": "ptk-zap-iast-finding-v3"
    },
    "structuredAck": {
      "const": true
    },
    "legacyAck": {
      "const": false
    },
    "batchId": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 128
    },
    "batchSeq": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 2147483647
    },
    "received": {
      "type": "integer",
      "minimum": 0,
      "maximum": 200
    },
    "accepted": {
      "type": "integer",
      "minimum": 0,
      "maximum": 200
    },
    "alertsRaised": {
      "type": "integer",
      "minimum": 0,
      "maximum": 200
    },
    "findingResults": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "findingId",
          "fingerprint",
          "status",
          "reason"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "findingId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "fingerprint": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "status": {
            "enum": [
              "accepted_raised",
              "accepted_duplicate",
              "rejected_missing_mapping",
              "rejected_raise_failed",
              "rejected_invalid_url",
              "rejected_missing_site_tree_match",
              "rejected_immutable_identity_conflict",
              "rejected_receipt_capacity",
              "rejected_retired_session"
            ]
          },
          "reason": {
            "enum": [
              "accepted_raised",
              "accepted_duplicate",
              "rejected_missing_mapping",
              "rejected_raise_failed",
              "rejected_invalid_url",
              "rejected_missing_site_tree_match",
              "rejected_immutable_identity_conflict",
              "rejected_receipt_capacity",
              "rejected_retired_session"
            ]
          },
          "alertRef": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 64
          }
        }
      }
    },
    "reasonCounts": {
      "type": "object",
      "propertyNames": {
        "enum": [
          "accepted_raised",
          "accepted_duplicate",
          "rejected_missing_mapping",
          "rejected_raise_failed",
          "rejected_invalid_url",
          "rejected_missing_site_tree_match",
          "rejected_immutable_identity_conflict",
          "rejected_receipt_capacity",
          "rejected_retired_session"
        ]
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 1,
        "maximum": 200
      }
    },
    "permanentFailure": {
      "type": "boolean"
    },
    "errorCode": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 80
    },
    "scanCompletenessAccepted": {
      "type": "boolean"
    },
    "scanCompletenessRevision": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 9007199254740991
    }
  }
}
