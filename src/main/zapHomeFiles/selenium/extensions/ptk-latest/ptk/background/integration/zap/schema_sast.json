{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ptk.local/schemas/ptk-zap-sast-finding-v1.json",
  "title": "PTK -> ZAP SAST Findings Batch (Minimum)",
  "type": "object",
  "additionalProperties": false,
  "required": ["source", "type", "schema", "ts", "batchId", "payload"],
  "properties": {
    "source": { "const": "ptk" },
    "type": { "const": "sast_findings_batch" },
    "schema": { "const": "ptk-zap-sast-finding-v1" },
    "ts": { "type": "integer", "minimum": 0 },
    "batchId": { "type": "string", "minLength": 1 },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engine", "scanId", "findings"],
      "properties": {
        "engine": { "const": "SAST" },
        "scanId": { "type": "string", "minLength": 1 },
        "truncated": { "type": "boolean" },
        "findings": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/finding" }
        }
      }
    }
  },
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "fingerprint",
        "moduleId",
        "ruleId",
        "severity",
        "confidence",
        "summary",
        "location",
        "source",
        "sink",
        "trace",
        "codeSnippet",
        "proof"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "fingerprint": { "type": "string", "minLength": 1 },
        "moduleId": { "type": "string", "minLength": 1 },
        "ruleId": { "type": "string", "minLength": 1 },
        "severity": {
          "type": "string",
          "enum": ["high", "medium", "low"]
        },
        "confidence": { "type": "integer", "minimum": 0, "maximum": 100 },
        "summary": { "type": "string", "minLength": 1 },
        "location": {
          "type": "object",
          "additionalProperties": false,
          "required": ["url", "route", "method", "param"],
          "properties": {
            "url": { "type": ["string", "null"], "format": "uri" },
            "route": { "type": ["string", "null"] },
            "method": { "type": ["string", "null"] },
            "param": { "type": ["string", "null"] }
          }
        },
        "proof": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "payload", "proof", "summary"],
          "properties": {
            "mode": {
              "type": "string",
              "enum": ["pattern", "taint", "hybrid", "unknown"]
            },
            "payload": { "type": ["string", "null"] },
            "proof": { "type": ["string", "null"] },
            "summary": { "type": "string", "minLength": 1 }
          }
        },
        "source": { "$ref": "#/$defs/sourceOrSink" },
        "sink": { "$ref": "#/$defs/sourceOrSink" },
        "trace": {
          "type": "array",
          "items": { "$ref": "#/$defs/traceStep" }
        },
        "codeSnippet": { "type": ["string", "null"] }
      }
    },
    "traceStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "label", "file", "line", "column"],
      "properties": {
        "kind": { "type": ["string", "null"] },
        "label": { "type": ["string", "null"] },
        "file": { "type": ["string", "null"] },
        "line": { "type": ["integer", "null"], "minimum": 1 },
        "column": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "sourceOrSink": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "file", "line", "column"],
      "properties": {
        "label": { "type": ["string", "null"] },
        "file": { "type": ["string", "null"] },
        "line": { "type": ["integer", "null"], "minimum": 1 },
        "column": { "type": ["integer", "null"], "minimum": 0 }
      }
    }
  }
}
